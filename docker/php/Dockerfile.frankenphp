FROM dunglas/frankenphp:1-php8.4-alpine

# Install system dependencies
RUN apk add --no-cache \
    git \
    curl \
    libpng-dev libpng \
    oniguruma-dev \
    libxml2-dev \
    libzip-dev \
    zip \
    unzip \
    icu-dev \
    freetype-dev freetype \
    libjpeg-turbo-dev libjpeg-turbo \
    libwebp-dev libwebp \
    libxpm-dev \
    imagemagick-dev \
    autoconf \
    g++ \
    make \
    pkgconf

# Install PHP extensions
RUN docker-php-ext-install \
    pdo_mysql \
    mbstring \
    exif \
    pcntl \
    bcmath \
    intl \
    zip

# GD (configure separately)
RUN docker-php-ext-configure gd \
    --with-freetype \
    --with-jpeg \
    --with-webp \
 && docker-php-ext-install gd

# Install Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Set working directory
WORKDIR /app

# Copy custom PHP configuration
COPY docker/php/php.ini /usr/local/etc/php/conf.d/custom.ini

# Create symfony user
RUN addgroup -g 1000 symfony && \
    adduser -D -s /bin/sh -u 1000 -G symfony symfony

# Create necessary directories
RUN mkdir -p /app/var/upload /app/vendor && \
    chown -R symfony:symfony /app && \
    chmod -R 775 /app/var/upload /app/vendor

# Copy application files
COPY --chown=symfony:symfony . /app

# Switch to app user
USER symfony

# Environment setup
RUN ln -sf .env.production .env

ENV DATABASE_URL="mysql://placeholder:placeholder@localhost:3306/placeholder?serverVersion=10.11&charset=utf8"

# Install PHP dependencies
RUN git config --global --add safe.directory /app && \
    composer install --no-dev --optimize-autoloader --no-interaction --no-scripts

# Switch back to root
USER root

# Startup script
COPY docker/php/startup.sh /startup.sh
RUN chmod +x /startup.sh

EXPOSE 80

CMD ["/startup.sh"]
